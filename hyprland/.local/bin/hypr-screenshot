#!/bin/sh
set -eu
for tool in grim slurp wl-copy; do
    command -v "$tool" >/dev/null || { notify-send 'Screenshot' "Missing tool: $tool"; exit 1; }
done
region=$(slurp) || exit 0
directory="$(xdg-user-dir PICTURES)/Screenshots"
mkdir -p "$directory"
file="$directory/$(date +%Y-%m-%d_%H-%M-%S)-$$.png"
grim -g "$region" "$file"
wl-copy --type image/png < "$file"
notify-send 'Screenshot saved and copied' "$file"
