{
  "layer": "top",
  "position": "bottom",
  "height": 32,
  "modules-left": [
    "custom/workspace-1",
    "custom/workspace-2",
    "custom/workspace-3",
    "custom/workspace-4",
    "custom/workspace-5",
    "custom/workspace-6",
    "custom/workspace-7",
    "custom/workspace-8",
    "custom/workspace-9",
    "custom/workspace-10",
    "custom/workspace-Browser",
    "custom/workspace-Terminal"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "tray"
  ],
  "clock": {
    "format": "{:%Y-%m-%d  %H:%M}"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "muted",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " connected",
    "format-disconnected": "offline"
  },
  "tray": {
    "spacing": 10
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 3,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "custom/workspace-1": {
    "exec": "$HOME/.local/bin/hypr-workspace-read 1",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'",
    "tooltip": false,
    "hide-empty-text": true,
    "exec-on-event": false,
    "signal": 8
  },
  "custom/workspace-2": {
    "exec": "$HOME/.local/bin/hypr-workspace-read 2",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'",
    "tooltip": false,
    "hide-empty-text": true,
    "exec-on-event": false,
    "signal": 8
  },
  "custom/workspace-3": {
    "exec": "$HOME/.local/bin/hypr-workspace-read 3",
